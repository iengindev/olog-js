{
  "name": "@olog-js/nestjs",
  "version": "0.1.0",
  "description": "NestJS integration for olog-js: module, LoggerService, request context and HTTP logging",
  "keywords": [
    "log",
    "logger",
    "logging",
    "typescript",
    "nest",
    "nestjs",
    "olog-js"
  ],
  "author": {
    "name": "iengindev",
    "email": "weendibol21300@gmail.com",
    "url": "https://github.com/iengindev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iengindev/olog-js.git"
  },
  "homepage": "https://github.com/iengindev/olog-js#readme",
  "bugs": "https://github.com/iengindev/olog-js/issues",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@olog-js/core": "^0.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@olog-js/core": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  }
}
