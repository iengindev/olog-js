{
  "name": "@olog-js/banner",
  "version": "1.0.0",
  "description": "olog-js - logger package",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "log",
    "logger"
  ],
  "author": "iengindev",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1"
}
