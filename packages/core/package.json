{
  "name": "@olog-js/core",
  "version": "0.1.0",
  "description": "Zero-dependency, type-safe logger core for every JavaScript runtime",
  "keywords": [
    "log",
    "logger",
    "logging",
    "typescript"
  ],
  "author": {
    "name": "iengindev",
    "email": "weendibol21300@gmail.com",
    "url": "https://github.com/iengindev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iengindev/olog-js.git"
  },
  "homepage": "https://github.com/iengindev/olog-js#readme",
  "bugs": "https://github.com/iengindev/olog-js/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  }
}
