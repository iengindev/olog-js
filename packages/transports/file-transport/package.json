{
  "name": "@olog-js/file-transport",
  "version": "1.0.0",
  "description": "olog-js - logger package",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "log",
    "logger"
  ],
  "author": "iengindev",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "peerDependencies": {
    "@olog-js/core": "workspace:^"
  },
  "devDependencies": {
    "@olog-js/core": "workspace:*",
    "@types/node": "^26.6.6"
  }
}
